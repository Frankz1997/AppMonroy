{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AppMonroy Horarios",
  "version": "0.1.0",
  "identifier": "com.appmonroy.horarios",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AppMonroy Horarios",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../Plantilla.xlsx": "Plantilla.xlsx",
      "../FormatoWordUAS.docx": "FormatoWordUAS.docx",
      "scripts/export_excel.py": "scripts/export_excel.py",
      "scripts/export_word.py": "scripts/export_word.py",
      "bin": "bin"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
